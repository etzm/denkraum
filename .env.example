# Copy to .env (never commit .env).

# Database: Postgres from infra/docker-compose.yml, or PGlite on disk without Docker.
DATABASE_URL=pglite:./.data/pglite
# DATABASE_URL=postgres://denkraum:denkraum@127.0.0.1:5432/denkraum

# Model access (packages/llm/src/config.ts):
#   mock      deterministic answers, no network (default, CI)
#   anthropic direct API, development with synthetic data only (blocked in production)
#   bedrock   Claude on Amazon Bedrock, EU region only (production path)
LLM_PROVIDER=mock
# AWS_REGION=eu-central-1
# ANTHROPIC_API_KEY=

# Optional model overrides per tier; defaults: Sonnet 5.5 for vision and hard, Haiku 4.5 for light.
# MODEL_VISION=anthropic.claude-sonnet-5-5
# MODEL_HARD=anthropic.claude-sonnet-5-5
# MODEL_LIGHT=anthropic.claude-haiku-4-5

# Optional prices in USD per million tokens "input,output" for the cost log.
# LLM_PRICE_VISION=
# LLM_PRICE_HARD=
# LLM_PRICE_LIGHT=

# Next.js sends anonymous usage telemetry unless disabled.
NEXT_TELEMETRY_DISABLED=1
