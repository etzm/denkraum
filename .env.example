# Copy to .env (never commit .env).

# Database: Postgres from infra/docker-compose.yml, or PGlite on disk without Docker.
DATABASE_URL=pglite:./.data/pglite
# DATABASE_URL=postgres://denkraum:denkraum@127.0.0.1:5432/denkraum

# Photo storage, always encrypted with AES-256-GCM (DECISIONS.md D-016).
#   fs      local directory BLOB_DIR (one server, default)
#   s3      S3-compatible bucket, e.g. Hetzner Object Storage (S3_* below)
BLOB_STORE=fs
BLOB_DIR=./.data/blobs
# 32 random bytes as base64, required in production: openssl rand -base64 32
# Keep it outside the repository and back it up: without it the photos cannot be read.
# BLOB_ENCRYPTION_KEY=
# S3_ENDPOINT=https://fsn1.your-objectstorage.com
# S3_REGION=eu-central
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Model access (packages/llm/src/config.ts). Swapping models is configuration only:
#   mock               deterministic answers, no network (default, CI)
#   anthropic          direct API, development with synthetic data only (blocked in production)
#   bedrock            Claude on Amazon Bedrock, EU region only (production path)
#   openai-compatible  vLLM, LiteLLM, Ollama or an EU-hosted open model (LLM_BASE_URL)
LLM_PROVIDER=mock
# AWS_REGION=eu-central-1
# ANTHROPIC_API_KEY=

# For openai-compatible: base URL (…/v1), optional key, all three models required, and in
# production LLM_ENDPOINT_IN_EU=true to confirm the endpoint runs in the EU or on your own server.
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# LLM_API_KEY=
# LLM_ENDPOINT_IN_EU=true

# Model per tier; defaults for anthropic/bedrock: Sonnet 5.5 for vision and hard, Haiku 4.5 for light.
# MODEL_VISION=anthropic.claude-sonnet-5-5
# MODEL_HARD=anthropic.claude-sonnet-5-5
# MODEL_LIGHT=anthropic.claude-haiku-4-5

# Optional prices in USD per million tokens "input,output" for the cost log.
# LLM_PRICE_VISION=
# LLM_PRICE_HARD=
# LLM_PRICE_LIGHT=

# Next.js sends anonymous usage telemetry unless disabled.
NEXT_TELEMETRY_DISABLED=1
