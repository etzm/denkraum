# Copy to infra/.env on the server, fill in, never commit (infra/.env is in .gitignore).

DENKRAUM_DOMAIN=denkraum.martinetzrodt.com

# Database password: openssl rand -base64 24
POSTGRES_PASSWORD=

# Photo encryption key, 32 bytes as base64: openssl rand -base64 32
# Back it up separately from the data. Without it the stored photos cannot be read.
BLOB_ENCRYPTION_KEY=

# Models: Claude on Amazon Bedrock in Frankfurt (DECISIONS.md D-013).
LLM_PROVIDER=bedrock
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional, to pin models per tier:
# MODEL_VISION=anthropic.claude-sonnet-5-5
# MODEL_HARD=anthropic.claude-sonnet-5-5
# MODEL_LIGHT=anthropic.claude-haiku-4-5

# Swap to an open model on your own or an EU server instead (D-004):
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=
# LLM_ENDPOINT_IN_EU=true
# MODEL_VISION=
# MODEL_HARD=
# MODEL_LIGHT=

# Until the content is approved, unapproved Schreibwerkstatt missions stay hidden (D-022).
# DENKRAUM_SHOW_UNAPPROVED=false
